# ─── Single source of truth: Atlas MongoDB ───────────────────────────────
# The backend, Admin, and participant frontend all read and write ONE
# database: Atlas. Copy your real Atlas connection string into your LOCAL
# `.env` as ATLAS_MONGO_URI. NEVER commit real credentials — fill this in
# only on your machine.
#
#   Admin change → API → Atlas        (one persistence path)
#   Participant → API → Atlas         (one read path)
#
# The app REFUSES to connect to a local MongoDB instance (localhost /
# 127.0.0.1 / 0.0.0.0), so local-vs-Atlas divergence cannot silently return.
#
# MONGO_URI is honoured as a compatibility alias for older tooling; the
# preferred variable is ATLAS_MONGO_URI.
ATLAS_MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=Cluster0
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=Cluster0

PORT=5000
CLIENT_ORIGINS=http://localhost:5175,http://localhost:5174,http://localhost:5176
QUESTION_TIMEOUT_SECONDS=45

# Admin authentication
ADMIN_JWT_SECRET=change-me-in-production
ADMIN_JWT_EXPIRES=6h
SUPER_ADMIN_EMAIL=admin@byrgop.local
SUPER_ADMIN_PASSWORD=change-me-in-production

# Email (optional)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=