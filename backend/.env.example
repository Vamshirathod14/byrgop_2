# Copy to .env and fill in real values. Never commit .env — it is gitignored.

# ─── Server ────────────────────────────────────────────────
PORT=5000
# MongoDB connection string (testing Atlas byrgop DB)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/byrgop_testing?appName=Cluster0
# Comma-separated list of allowed browser origins (production + local dev)
# Production: https://byrgop.com,https://www.byrgop.com (or your deployed frontend domains)
# Local: http://localhost:5175,http://localhost:5174
CLIENT_ORIGINS=https://byrgop.com,https://www.byrgop.com,http://localhost:5175,http://localhost:5174
QUESTION_TIMEOUT_SECONDS=45

# ─── Admin authentication ──────────────────────────────────
ADMIN_JWT_SECRET=change-me-to-a-long-random-secret
ADMIN_JWT_EXPIRES=8h
ADMIN_BCRYPT_ROUNDS=12

# Initial Super Admin bootstrap (one-time; remove after first run)
SUPER_ADMIN_EMAIL=admin@byrgop.local
SUPER_ADMIN_PASSWORD=ChangeMe!12345

# ─── Report email (Hostinger SMTP — customercare@byrgop.com) ───
# Recommended Hostinger SMTP: host smtp.hostinger.com, port 465 (SSL/TLS).
# Port 587 with SMTP_SECURE=false (STARTTLS) is the alternative.
# SMTP_USER / EMAIL_FROM = the full mailbox address.
# SMTP_PASS = the mailbox password (hPanel → Emails → Email Accounts), NOT the
# hPanel login password. Hold in the environment; never hardcode or commit it.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=customercare@byrgop.com
SMTP_PASS=
EMAIL_FROM=customercare@byrgop.com
EMAIL_FROM_NAME=BYRGOP Customer Care
EMAIL_REPLY_TO=customercare@byrgop.com

# PDF header logo override (optional). Defaults to frontend/public/black_logo.jpg
# REPORT_LOGO_PATH=/absolute/path/to/black_logo.jpg

# PDF watermark override (optional). Defaults to frontend/public/pdf_water_mark.jpeg
# PDF_WATERMARK_PATH=/absolute/path/to/pdf_water_mark.jpeg