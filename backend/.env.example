# Local development database (used by `node src/server.js` and all seed/verify scripts)
MONGO_URI=mongodb://127.0.0.1:27017/byrgop

# Atlas connection string for migration/audit scripts that read from production.
# NEVER commit real credentials. Set this locally before running syncAtlasToLocal.mjs
# or any auditAtlas*.mjs script.
# ATLAS_MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=Cluster0

PORT=5000
CLIENT_ORIGINS=http://localhost:5175,http://localhost:5174,http://localhost:5176
QUESTION_TIMEOUT_SECONDS=45

# Admin authentication
ADMIN_JWT_SECRET=change-me-in-production
ADMIN_JWT_EXPIRES=8h
SUPER_ADMIN_EMAIL=admin@byrgop.local
SUPER_ADMIN_PASSWORD=change-me-in-production

# Email (optional)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=